# OpenGEO Platform · local 模式（生成于 2026-08-24，密钥为本机随机生成）
DATABASE_URL=postgres://<user>@localhost:5432/opengeo_platform
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=   # openssl rand -base64 32
ELMO_ENCRYPTION_KEY=  # openssl rand -base64 32
DISABLE_TELEMETRY=1

# ---- 采集目标 ----
# 初始为 stub（无网络、零成本，跑通全流程用）。启用真实引擎：替换 SCRAPE_TARGETS 并填入对应 Key。
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub

# ---- 中文引擎（官方 API 通道，填 Key 后把目标并入 SCRAPE_TARGETS）----
# SCRAPE_TARGETS=doubao:volcengine:doubao-seed-2-0-lite-260215:online,qwen:dashscope:qwen-plus:online,deepseek:deepseek-api:deepseek-chat,yuanbao:tencent-tokenhub:hunyuan-turbos-latest:online
# ARK_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# TENCENT_TOKENHUB_API_KEY=

# ---- 国际引擎 scraped 通道（二选一，注册后填 Key 并并入目标）----
# Cloro（推荐：全覆盖最可靠，$30/月起）https://cloro.dev
# SCRAPE_TARGETS 追加: chatgpt:cloro:online,google-ai-mode:cloro:online,google-ai-overview:cloro:online,gemini:cloro:online,perplexity:cloro:online,copilot:cloro:online
# CLORO_API_KEY=
# BrightData（按量付费 $10 起，AI Overview 较弱）https://brightdata.com
# SCRAPE_TARGETS 追加: chatgpt:brightdata:online,google-ai-mode:brightdata:online,gemini:brightdata:online,perplexity:brightdata:online,copilot:brightdata:online
# BRIGHTDATA_API_TOKEN=

# ---- 国际引擎 api 通道（模型直连，成本=调用费）----
# SCRAPE_TARGETS 追加: chatgpt:openai-api:gpt-5-mini:online,claude:anthropic-api:claude-sonnet-5:online
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
